{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch MyContractor",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build MyContractor",
      "program": "${workspaceFolder}/bin/Debug/net10.0/MyContractor.dll",
      "args": ["--urls", "http://localhost:5000"],
      "cwd": "${workspaceFolder}",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
