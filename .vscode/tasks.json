{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Angular",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "Build .NET",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/MyContractor.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build MyContractor",
      "dependsOrder": "sequence",
      "dependsOn": ["Build Angular", "Build .NET"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
