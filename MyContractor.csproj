<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AngularOutput>$(MSBuildProjectDirectory)/dist/client/browser</AngularOutput>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;dist/**;.angular/**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="BuildAndPublishAngular" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm ci" Condition="'$(SkipAngularBuild)' != 'true'" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build" Condition="'$(SkipAngularBuild)' != 'true'" />
    <Error Condition="!Exists('$(AngularOutput)/index.html')" Text="The Angular build is missing. Run npm ci and npm run build before publishing with SkipAngularBuild=true." />
    <ItemGroup>
      <AngularPublishAsset Include="$(AngularOutput)/**/*" />
      <ResolvedFileToPublish Include="@(AngularPublishAsset)">
        <RelativePath>wwwroot/%(AngularPublishAsset.RecursiveDir)%(AngularPublishAsset.Filename)%(AngularPublishAsset.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
